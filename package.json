{
  "name": "grason-oms",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "build": "pnpm -r --filter=./packages/** build && pnpm -r --filter=./apps/** build",
    "dev": "pnpm -r --parallel --filter=./apps/** dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && pnpm contract:lint",
    "format": "prettier --write .",
    "test": "pnpm contract:lint && pnpm -r --workspace-concurrency=1 test",
    "contract:lint": "redocly lint docs/api-contract/cs-ai.v1.yaml docs/api-contract/cs-ai.v2.yaml docs/api-contract/ethix.v1.yaml docs/api-contract/adv-ai.v1.yaml docs/api-contract/adv-ai.v2.yaml",
    "db:migrate": "pnpm --filter @grason/db migrate:dev",
    "db:deploy": "pnpm --filter @grason/db migrate:deploy",
    "db:seed": "pnpm --filter @grason/db seed",
    "db:studio": "pnpm --filter @grason/db studio",
    "apikey:create": "pnpm --filter @grason/api apikey:create",
    "sim": "pnpm --filter @grason/simulator sim",
    "demo:reset": "pnpm --filter @grason/api demo:reset",
    "uji": "node scripts/uji.mjs",
    "uji:siapkan": "node scripts/uji.mjs siapkan"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@redocly/cli": "2.71.2",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
