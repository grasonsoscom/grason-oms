# Salin ke .env dan ganti nilai yang ditandai GANTI. Jangan commit .env.

# --- Infrastruktur (docker-compose) ---
POSTGRES_USER=grason
POSTGRES_PASSWORD=GANTI_password_lokal
POSTGRES_PORT=5433
REDIS_PORT=6380

# --- Database ---
DATABASE_URL=postgresql://grason:GANTI_password_lokal@localhost:5433/grason_oms
TEST_DATABASE_URL=postgresql://grason:GANTI_password_lokal@localhost:5433/grason_oms_test

# --- Redis ---
REDIS_URL=redis://localhost:6380

# --- API ---
API_PORT=3001
# Origin dashboard web, untuk CORS dan cookie sesi.
WEB_ORIGIN=http://localhost:3000
# Masa berlaku sesi login dalam jam.
SESSION_TTL_HOURS=12

# --- Web (Next.js meneruskan /api/v1 ke API) ---
API_INTERNAL_URL=http://localhost:3001

# --- Seed: akun Orkestrator pertama ---
SEED_ADMIN_EMAIL=orkestrator@grason.local
SEED_ADMIN_PASSWORD=GANTI_minimal_12_karakter
SEED_ADMIN_NAME=Orkestrator
