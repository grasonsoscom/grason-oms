# Salin ke .env dan ganti nilai yang ditandai GANTI. Jangan commit .env.

# --- Infrastruktur (docker-compose) ---
POSTGRES_USER=grason
POSTGRES_PASSWORD=GANTI_password_lokal
POSTGRES_PORT=5433
REDIS_PORT=6380

# --- Database ---
DATABASE_URL=postgresql://grason:GANTI_password_lokal@localhost:5433/grason_oms
TEST_DATABASE_URL=postgresql://grason:GANTI_password_lokal@localhost:5433/grason_oms_test

# --- Redis ---
REDIS_URL=redis://localhost:6380

# --- API ---
API_PORT=3001
# Origin dashboard web, untuk CORS dan cookie sesi.
WEB_ORIGIN=http://localhost:3000
# Masa berlaku sesi login dalam jam.
SESSION_TTL_HOURS=12
# Batas permintaan per API key per menit (0 = tanpa batas). Kunci simulator di mode demo
# tidak dibatasi.
RATE_LIMIT_API_KEY_PER_MENIT=60
# Nama cookie sesi. Lingkungan uji sambung (.env.uji) memakai oms_sesi_uji.
SESSION_COOKIE=oms_sesi

# --- Web (Next.js meneruskan /api/v1 ke API) ---
API_INTERNAL_URL=http://localhost:3001

# --- Seed: akun Orkestrator pertama ---
SEED_ADMIN_EMAIL=orkestrator@grason.local
SEED_ADMIN_PASSWORD=GANTI_minimal_12_karakter
SEED_ADMIN_NAME=Orkestrator

# --- Demo (Fase 1–2) ---
# true = API menerima X-Sim-Waktu dari kunci simulator dan akun demo, dan pnpm demo:reset
# boleh jalan. Kunci CS AI lain tetap memakai jam server.
# Jangan pernah true di produksi.
DEMO_MODE=false
# Password semua akun demo (*@demo.grason.local), minimal 12 karakter.
DEMO_PASSWORD=GANTI_minimal_12_karakter
# Opsional: API key simulator. Bila kosong, pnpm sim memakai .demo/kunci-simulator.json
# dari pnpm demo:reset.
# SIM_CS_AI_KEY=
# SIM_ETHIX_KEY=

# --- Webhook ke SaaS CS AI (worker) ---
# Hanya diisi di .env.uji (pnpm uji:siapkan). Kosong = webhook tidak dikirim.
# CS_AI_WEBHOOK_URL=
# CS_AI_WEBHOOK_SECRET=
